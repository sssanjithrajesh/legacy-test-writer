<?xml version="1.0" encoding="UTF-8"?>
<!--
  Build for the legacy module under test: the `language` package of Apache Commons Codec 1.3
  (2004-2005), vendored unchanged under src/main/java. Tests under src/test/java are GENERATED
  by the legacy-test-writer tool; do not hand-edit them.

  Profiles:
    (default)   compile 1.3 sources + generated tests, JaCoCo coverage, PIT mutation testing
    reference   swap the generated tests for the maintainers' original JUnit 3 suite (evals/reference)
    next        compile the generated tests against Commons Codec 1.5 sources (legacy-next) to find drift
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <groupId>dev.ltw</groupId>
  <artifactId>legacy-codec-language</artifactId>
  <version>1.3-legacy</version>
  <packaging>jar</packaging>

  <properties>
    <project.build.sourceEncoding>US-ASCII</project.build.sourceEncoding>
    <maven.compiler.release>17</maven.compiler.release>
    <junit.version>5.10.2</junit.version>
    <jacoco.version>0.8.12</jacoco.version>
    <pitest.version>1.17.1</pitest.version>
    <pitest.junit5.version>1.2.1</pitest.junit5.version>
    <ltw.sourceDirectory>${project.basedir}/src/main/java</ltw.sourceDirectory>
    <ltw.testSourceDirectory>${project.basedir}/src/test/java</ltw.testSourceDirectory>
  </properties>

  <dependencies>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <!-- The maintainers' original suite is JUnit 3; vintage runs it on the JUnit 5 platform. -->
    <dependency>
      <groupId>org.junit.vintage</groupId>
      <artifactId>junit-vintage-engine</artifactId>
      <version>${junit.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>junit</groupId>
      <artifactId>junit</artifactId>
      <version>4.13.2</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <sourceDirectory>${ltw.sourceDirectory}</sourceDirectory>
    <testSourceDirectory>${ltw.testSourceDirectory}</testSourceDirectory>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <configuration>
          <compilerArgs>
            <arg>-Xlint:none</arg>
          </compilerArgs>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.2.5</version>
        <configuration>
          <failIfNoTests>false</failIfNoTests>
          <trimStackTrace>true</trimStackTrace>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco.version}</version>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals><goal>prepare-agent</goal></goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>test</phase>
            <goals><goal>report</goal></goals>
            <configuration>
              <formats><format>XML</format></formats>
            </configuration>
          </execution>
        </executions>
      </plugin>
      <plugin>
        <groupId>org.pitest</groupId>
        <artifactId>pitest-maven</artifactId>
        <version>${pitest.version}</version>
        <dependencies>
          <dependency>
            <groupId>org.pitest</groupId>
            <artifactId>pitest-junit5-plugin</artifactId>
            <version>${pitest.junit5.version}</version>
          </dependency>
        </dependencies>
        <configuration>
          <targetClasses>
            <param>org.apache.commons.codec.language.*</param>
          </targetClasses>
          <targetTests>
            <param>org.apache.commons.codec.*</param>
          </targetTests>
          <outputFormats>
            <param>XML</param>
          </outputFormats>
          <fullMutationMatrix>true</fullMutationMatrix>
          <timestampedReports>false</timestampedReports>
          <threads>4</threads>
          <timeoutConstant>4000</timeoutConstant>
          <failWhenNoMutations>false</failWhenNoMutations>
        </configuration>
      </plugin>
    </plugins>
  </build>

  <profiles>
    <profile>
      <id>reference</id>
      <properties>
        <ltw.testSourceDirectory>${project.basedir}/../evals/reference/java</ltw.testSourceDirectory>
      </properties>
    </profile>
    <profile>
      <id>next</id>
      <properties>
        <ltw.sourceDirectory>${project.basedir}/../legacy-next/src/main/java</ltw.sourceDirectory>
      </properties>
    </profile>
  </profiles>
</project>
